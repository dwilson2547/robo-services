CM_ "2008 Chevrolet Impala (owner-stated; the broadcast VIN's model-year character also reads 2008), HS-CAN read from the OBD port by the dongle. Rebuilt 2026-11-25 from the first-draft file against 15 logs of 2026-11-03 to 2026-11-24 (13,789 s with phone-GPS speed, top speed 86 km/h). Signals the data disproved were removed and are listed in analysis/gm/chevy_impala_2008.md; signals the data neither proved nor disproved stay tagged [unverified]. Tags: [verified] = checked against an independent reference by the method named; [candidate] = plausible but not tied to the physical quantity; [unverified] = carried over, no evidence either way. Byte order is per signal as found: @1 (Intel) throughout except the 16-bit values at @0 (Motorola). Message rates are measured from the 5 drives of 2026-11-24.";

CM_ BU_ PCM "Powertrain Control Module (K20_ECM)";
CM_ BU_ EBCM "Electronic Brake Control Module (K17_EBCM)";
CM_ BU_ TCM "Transmission Control Module";
CM_ BU_ BCM "Body Control Module (K9_BCM)";

CM_ BO_ 201 "Engine status: rpm, brake pedal flag, throttle position. 78.6 Hz.";
CM_ BO_ 241 "Brake line pressure and applied flag from the brake module. 98.3 Hz.";
CM_ BO_ 298 "Door and seatbelt status from the body module. 9.8 Hz.";
CM_ BO_ 401 "Injector pulse width for the three banks. 78.6 Hz.";
CM_ BO_ 497 "General platform status: power mode, park brake switch. 9.8 Hz.";
CM_ BO_ 501 "Selector lever position (PRNDL) from the transmission module. 39.3 Hz.";
CM_ BO_ 840 "Front wheel speeds FL/FR. 20.5 Hz.";
CM_ BO_ 842 "Rear wheel speeds RL/RR. 20.5 Hz.";
CM_ BO_ 961 "Tyre pressure sensor 1; which tyre is not known. 9.8 Hz.";
CM_ BO_ 969 "Tyre pressure sensor 2; which tyre is not known. 9.8 Hz.";
CM_ BO_ 1001 "Vehicle speed in mph from the engine module. 9.8 Hz.";
CM_ BO_ 1217 "Engine coolant and intake air temperatures. 2.0 Hz.";
CM_ BO_ 1225 "A temperature channel whose source is not identified. 2.0 Hz.";
CM_ BO_ 1249 "VIN broadcast part 2, characters 10-17. 1.0 Hz.";
CM_ BO_ 1265 "Fuel rail pressure. 1.0 Hz.";
CM_ BO_ 1300 "VIN broadcast part 1, characters 2-9 (character 1 is not broadcast). 1.0 Hz.";

CM_ SG_ 201 EngineRPM "[candidate] Engine speed, x0.25 from the first-draft notes. Idle median 694 rpm (middle 80 % 641-919) over 5,045 s stopped; range 0-3667; follows EngineTPS (r=0.89). No clean per-gear ladder (torque-converter automatic; one clear level at 16-18 rpm per km/h at steady speed), so dbc_check.py gives PLAUSIBLE. The x0.25 scale has no independent check.";
CM_ SG_ 201 BrakePedalPressed "[verified] Brake pedal flag. Median acceleration is -3.9 km/h/s while set (1,038 s) and +0.3 km/h/s while clear (3,635 s), phone GPS.";
CM_ SG_ 201 EngineTPS "[candidate] Throttle position, byte 4, x0.392157 % (scale from the first-draft notes' EngineTPS entry; byte found by data). Reads 0 at idle and in deceleration, 9 % at steady speed above 60 km/h, 13, 17, 20 and 23 % at +1 to +4 km/h/s, max 61 %. Cannot tell the pedal from the throttle plate.";
CM_ SG_ 241 BrakePressure "[candidate] Brake line pressure. Declared kPa reads 7 with the flag clear and 110 with it set (max 216), and tracks deceleration (r=0.62). The kPa scale (x1.3) is unchecked; use for relative effort only.";
CM_ SG_ 241 BrakeApplied "[verified] Brake applied flag, same behaviour as BrakePedalPressed: median acceleration -3.9 km/h/s while set, +0.3 while clear.";
CM_ SG_ 298 RearLeftDoor "[unverified] Constant 0 in 15 logs but one stationary capture; no record of when a door was opened.";
CM_ SG_ 298 FrontLeftDoor "[unverified] Constant 0 in 15 logs but one stationary capture; no record of when a door was opened.";
CM_ SG_ 298 FrontRightDoor "[unverified] Constant 0 in all 15 logs.";
CM_ SG_ 298 LeftSeatBelt "[unverified] Constant 0 in all 15 logs including the driver's drives; the meaning of 0 is not known.";
CM_ SG_ 298 RearRightDoor "[unverified] Reads 1 for part of one stationary capture (2026-11-03), 0 elsewhere; no record of what was done.";
CM_ SG_ 298 RightSeatBelt "[unverified] Constant 1 in all 15 logs.";
CM_ SG_ 401 InjectorPW_Bank1 "[unverified] Tracks rpm (r=0.76), median 7,037 us declared (x4 us scale unchecked).";
CM_ SG_ 401 InjectorPW_Bank2 "[unverified] As Bank1; one second averaged 72,822 us, a glitch frame or a mis-sized field.";
CM_ SG_ 401 InjectorPW_Bank3 "[unverified] As Bank1.";
CM_ SG_ 497 SystemPowerMode "[candidate] Reads 2 (Run) in every drive; no other value was ever seen, so the table is unchecked.";
CM_ SG_ 497 SystemBackUpPowerMode "[unverified] Varies 0 to 3 without a pattern checked against anything.";
CM_ SG_ 497 ParkBrakeSwActive "[unverified] Reads 0 throughout; never seen set.";
CM_ SG_ 501 PRNDL "[verified] Selector lever position. A lever sweep in the 2026-11-03 stationary capture reads 1, 2, 3, 4, 5, 6, 7 and back to 1. In drives: 1 at the start and end of every log, 2 only at speeds up to 10 km/h (backing out), 4 for all driving up to 86 km/h. Park, reverse, neutral and drive for 1-4 come from lever order and the driving; 5-7 are the positions beyond drive and are not identified. A gear number is not in this message.";
CM_ SG_ 840 FLWheelSpd "[verified] Front left wheel speed. r=0.992; GPS = 0.964 x declared, flat from 20 to 100 km/h. Reads about 3.6 % above GPS; tyre circumference versus the 0.0311 scale cannot be separated from the data.";
CM_ SG_ 840 FRWheelSpd "[verified] Front right wheel speed. r=0.992; GPS = 0.962 x declared.";
CM_ SG_ 842 RLWheelSpd "[verified] Rear left wheel speed. r=0.992; GPS = 0.967 x declared.";
CM_ SG_ 842 RRWheelSpd "[verified] Rear right wheel speed. r=0.992; GPS = 0.965 x declared.";
CM_ SG_ 961 TPMSStatus1 "[unverified] Constant 7 in all 15 logs.";
CM_ SG_ 961 TirePressure1 "[unverified] Constant 202 kPa across 3 weeks of drives; no sign of a live reading.";
CM_ SG_ 969 TPMSStatus2 "[unverified] Constant 7 in all 15 logs.";
CM_ SG_ 969 TirePressure2 "[unverified] Constant 204 kPa across 3 weeks of drives; no sign of a live reading.";
CM_ SG_ 1001 VehicleSpeed "[verified] Vehicle speed in mph, x0.01. r=0.993 vs GPS. GPS = 0.952 x declared (km/h) at 20-100 km/h with 0.16 km/h intercept, so it reads 4.8 % above GPS like a speedometer. The mph unit is consistent: it agrees with the wheel-speed signals to within 1.2 %.";
CM_ SG_ 1001 VehicleSpeedLeft "[verified] A second speed channel in the same message, r=0.993 vs GPS; GPS = 0.955 x declared.";
CM_ SG_ 1217 EngineCoolantTemp "[verified] Coolant temperature. From a cold start at 10 C it reads 49, 74, 87 and 88 C at minutes 2, 5, 8 and 10, then holds 88-92 C.";
CM_ SG_ 1217 IntakeAirTemp "[candidate] At the same cold start it reads 4 C (coolant 10 C, AuxTemp 3 C), then rises with engine heat. Not checked against ambient.";
CM_ SG_ 1225 AuxTemp "[candidate] A temperature of unidentified source: 3 C at the cold start, rising to 58 C over drives. A transmission or similar fluid is plausible; nothing identifies it.";
CM_ SG_ 1249 VINPart2_Char1 "[verified] VIN character 10, the model-year character; reads '8', 2008. Characters 10-17 are printable ASCII and identical in all 15 logs.";
CM_ SG_ 1300 VINPart1_Char1 "[verified] VIN character 2. Characters 2-9 are printable ASCII and identical in all 15 logs; character 9, the check digit, is valid when the unbroadcast first character is 2 (four first characters satisfy the arithmetic). The VIN itself is kept out of this file.";
CM_ SG_ 1249 VINPart2_Char2 "[verified] VIN character 11; see VINPart2_Char1.";
CM_ SG_ 1249 VINPart2_Char3 "[verified] VIN character 12; see VINPart2_Char1.";
CM_ SG_ 1249 VINPart2_Char4 "[verified] VIN character 13; see VINPart2_Char1.";
CM_ SG_ 1249 VINPart2_Char5 "[verified] VIN character 14; see VINPart2_Char1.";
CM_ SG_ 1249 VINPart2_Char6 "[verified] VIN character 15; see VINPart2_Char1.";
CM_ SG_ 1249 VINPart2_Char7 "[verified] VIN character 16; see VINPart2_Char1.";
CM_ SG_ 1249 VINPart2_Char8 "[verified] VIN character 17; see VINPart2_Char1.";
CM_ SG_ 1300 VINPart1_Char2 "[verified] VIN character 3; see VINPart1_Char1.";
CM_ SG_ 1300 VINPart1_Char3 "[verified] VIN character 4; see VINPart1_Char1.";
CM_ SG_ 1300 VINPart1_Char4 "[verified] VIN character 5; see VINPart1_Char1.";
CM_ SG_ 1300 VINPart1_Char5 "[verified] VIN character 6; see VINPart1_Char1.";
CM_ SG_ 1300 VINPart1_Char6 "[verified] VIN character 7; see VINPart1_Char1.";
CM_ SG_ 1300 VINPart1_Char7 "[verified] VIN character 8; see VINPart1_Char1.";
CM_ SG_ 1300 VINPart1_Char8 "[verified] VIN character 9; see VINPart1_Char1.";
CM_ SG_ 1265 FuelPressure1 "[unverified] Constant 435 in all 15 logs; unit unchecked.";
CM_ SG_ 1265 FuelPressure2 "[unverified] Constant 435 in all 15 logs; unit unchecked.";

VAL_ 501 PRNDL 4 "Drive" 3 "Neutral" 2 "Reverse" 1 "Park" ;
VAL_ 497 SystemPowerMode 2 "Run" ;
